# Browser only receives same-origin routes. Internal Agent Registry and
# FAB-specific Orchestration URLs are server-only CD configuration.
VITE_API_BASE_URL=/api
VITE_SERVICE_MODE=mock
# Production default: Browser -> /api/copilotkit -> Runtime routes by forwardedProps.fab.
VITE_AGENT_RUNTIME_TRANSPORT=proxy
# Only used when explicitly switching to direct mode for local integration.
VITE_AGENT_ORCHESTRATION_ENDPOINTS_JSON={"F15B":"https://agent-f15b.company.example","F18B":"https://agent-f18b.company.example"}

# Server-only examples (do NOT expose as VITE_*):
# AGENT_REGISTRY_BASE_URL=https://agent-registry.company.example
# App Server / Copilot Runtime server-only configuration:
# AGENT_ORCHESTRATION_BASE_URLS_JSON={"F15B":"https://agent-f15b.company.example","F18B":"https://agent-f18b.company.example"}
# PORT=3000
# HOST=127.0.0.1
# 关闭 CopilotKit 匿名遥测（生产建议开启）
# COPILOTKIT_TELEMETRY_DISABLED=true
