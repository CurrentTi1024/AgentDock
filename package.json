{
  "name": "agentdock-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --experimental-strip-types server/index.ts",
    "server:dev": "node --experimental-strip-types --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/api/runtime/*.test.ts src/api/session/*.test.ts src/i18n/*.test.ts src/features/chat/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@copilotkit/a2ui-renderer": "1.68.1",
    "@copilotkit/react-core": "1.68.1",
    "@copilotkit/runtime": "1.68.1",
    "@lobehub/editor": "^4.24.1",
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "^5.11.0",
    "@lobehub/ui": "^5.31.1",
    "antd": "6.3.5",
    "antd-style": "4.1.0",
    "dexie": "^4.2.0",
    "lucide-react": "^1.31.0",
    "motion": "^12.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "remark-gfm": "^4.0.1",
    "rxjs": "7.8.1",
    "zod": "^3.25.76",
    "zustand": "5.0.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vite": "8.0.16"
  },
  "packageManager": "pnpm@10.33.0"
}
